{
  "name": "moesegfault-status-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "test": "vitest run",
    "test:rust": "cargo test --workspace",
    "test:database": "python -m unittest discover -s tests/database -v",
    "contracts:check": "pnpm --filter @moesegfault/contracts generate:openapi && git diff --exit-code -- packages/contracts/openapi.json",
    "openapi:lint": "redocly lint packages/contracts/openapi.json",
    "release:test": "vitest run scripts/release",
    "typecheck": "pnpm -r --if-present typecheck && pnpm --filter @moesegfault/contracts build && pnpm --filter @moesegfault/telemetry build",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "build": "pnpm -r --if-present build",
    "db:migrate:local": "wrangler d1 migrations apply moesegfault-status --local",
    "db:migrate:remote": "wrangler d1 migrations apply moesegfault-status --remote"
  },
  "devDependencies": {
    "@redocly/cli": "2.52.1",
    "@cloudflare/workers-types": "5.20260911.1",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "wrangler": "4.131.1"
  }
}
