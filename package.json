{
  "name": "moesegfault-status-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "scripts": {
    "test": "vitest run apps/ops packages tests scripts",
    "test:runtime": "vitest run tests",
    "build:rust-runtime": "worker-build tests/rust-runtime --release --no-opt -- --locked && worker-build tests/telemetry-runtime --release --no-opt -- --locked && worker-build tests/scheduling-runtime --release --no-opt -- --locked && worker-build tests/diagnostic-client-runtime --release --no-opt -- --locked",
    "build:backend": "cargo run --locked -p status-build -- --service all",
    "build:frontend": "pnpm --filter @moesegfault/ops build",
    "test:rust": "cargo test --locked --workspace",
    "test:database": "python -m unittest discover -s tests/database -v && python crates/status-backend/src/deployments/test_sql.py",
    "contracts:check": "pnpm --filter @moesegfault/contracts generate:openapi && git diff --exit-code -- packages/contracts/openapi.json",
    "openapi:lint": "redocly lint packages/contracts/openapi.json",
    "release:test": "cargo test --locked -p status-release -p status-build",
    "typecheck": "pnpm --filter @moesegfault/contracts typecheck && pnpm --filter @moesegfault/ops typecheck",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "build": "pnpm build:frontend && pnpm build:backend",
    "deploy:check": "wrangler deploy --dry-run --config wrangler.jsonc && wrangler deploy --dry-run --config workers/ops-gateway/wrangler.jsonc && wrangler deploy --dry-run --config workers/probe-executor/wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply moesegfault-status --local",
    "db:migrate:remote": "wrangler d1 migrations apply moesegfault-status --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "@redocly/cli": "2.52.1",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20260911.0-alpha",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "wrangler": "4.131.1"
  }
}
