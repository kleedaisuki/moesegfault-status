{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "moesegfault-probe-asia",
  "main": "build/index.js",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "placement": { "region": "aws:ap-southeast-1" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
  "version_metadata": { "binding": "WORKER_VERSION" },
  "vars": {
    "ENVIRONMENT": "development",
    "STATUS_VERSION": "0.1.0",
    "DEPLOYMENT_ID": "",
    "GIT_COMMIT": "",
    "ARTIFACT_DIGEST": "",
    "EXECUTOR_ID": "probe-asia-v1",
    "EXECUTOR_LOCATION": "asia",
    "EXECUTOR_ALLOWED_KINDS": "[\"http\",\"tcp\",\"dns\",\"rpc\",\"synthetic\"]",
    "PROBE_ALLOWED_HOSTS": "[]",
    "PROBE_ALLOWED_TCP_PORTS": "[]",
    "PROBE_BINDING_CONFIG": "{}",
  },
}
